# NextAuth
AUTH_SECRET=          # openssl rand -base64 32
AUTH_URL=http://localhost:3000

# Google OAuth (Google Cloud Console에서 생성)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# BigQuery
BQ_PROJECT_ID=
BQ_DATASET=sales
BQ_TABLE=sales
# 로컬 개발: gcloud auth application-default login 실행 후 자동 인증
